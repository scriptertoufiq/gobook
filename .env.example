APP_NAME=GoBook
APP_ENV=local
APP_URL=http://localhost:8080
APP_PORT=8080
APP_DEBUG=true
APP_SHUTDOWN_TIMEOUT=10

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=go_mvc
DB_CHARSET=utf8mb4
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=60

# REQUIRED — the app refuses to boot without it. Minimum 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=gobook
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=720

# The email-verification switch. When false the flow is inert: no mail is sent
# and no route is gated. When true, MAIL_HOST and MAIL_FROM_ADDRESS are required.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_VERIFICATION_TTL=24

# Password reset. TTL is in MINUTES — a live reset link is a temporary key to
# the account, so keep the window short. The URL is where the emailed link
# points: your frontend form, which then POSTs to /auth/password/reset.
# Defaults to {APP_URL}/reset-password.
AUTH_PASSWORD_RESET_TTL=60
AUTH_PASSWORD_RESET_URL=

# Leave MAIL_USERNAME empty for a local relay (Mailpit/MailHog on :1025) —
# net/smtp refuses to send credentials over an unencrypted connection.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=GoBook

# Comma-separated list, or * / empty for any origin
CORS_ALLOWED_ORIGINS=*

# Throttling. The general limit covers every /api/v1 route; the auth limit
# stacks on top for /api/v1/auth/*, which sends mail and runs bcrypt for
# unauthenticated callers. Windows are in SECONDS. Callers are keyed by client
# IP — throttling runs before authentication, so there is no user id yet.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=60

# Whose X-Forwarded-For header to believe, as comma-separated CIDRs.
# EMPTY = trust nobody and use the socket address (correct when the app is
# directly exposed). Behind a load balancer, list it — e.g. 10.0.0.0/8 — or
# ClientIP() reports the balancer and every caller shares one bucket.
# Never set this to 0.0.0.0/0: that lets anyone spoof their way past the limit.
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Redis cache
#
# Disabled by default: with REDIS_ENABLED=false nothing connects and a no-op
# cache is used, so the app behaves identically — correct, just not cached.
#
# When enabled, the app PINGs Redis at boot and REFUSES TO START if it cannot
# reach it. That is deliberate: you asked for a cache, so a silent fallback
# would hide a broken deployment. At runtime it is the opposite — if Redis
# goes away mid-flight, reads degrade to misses rather than failing requests.
#
# For a managed/cloud Redis, set REDIS_USERNAME too (Redis 6+ ACLs). Leave it
# empty for a plain password-only or unauthenticated local server.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# Namespaces every key, so one Redis instance can back several apps or
# environments without them overwriting each other.
REDIS_PREFIX=gobook

# Seconds. A cache slower to answer than MySQL has stopped being a cache.
REDIS_DIAL_TIMEOUT=5
REDIS_TIMEOUT=3
REDIS_POOL_SIZE=10

# Seconds an entry lives when the caller does not specify its own TTL.
CACHE_DEFAULT_TTL=300

# How long a cached post lives, in seconds. Defaults to CACHE_DEFAULT_TTL.
#
# Set to 0 for "never expires". That is safe here because the post cache is
# kept correct by events, not by the clock: writing a post files it, editing
# replaces it, deleting removes it. Expiry is only a backstop for changes made
# outside this app — a manual SQL edit — and for the rare case where the
# process dies between saving a post and announcing it.
#
# Before setting 0, give Redis a memory ceiling. With no expiry and the default
# `maxmemory 0` + `noeviction`, the keyspace only ever grows, and once Redis is
# full it starts REFUSING writes rather than discarding cold entries:
#   redis-cli CONFIG SET maxmemory 256mb
#   redis-cli CONFIG SET maxmemory-policy allkeys-lru
CACHE_POST_TTL=

# How often reactions held in Redis are written to the database, in seconds.
#
# This is also the window in which a Redis failure loses reactions, so short is
# safer. Longer collapses more repeat-tapping into a single write, but buys
# little beyond a few seconds.
REACTION_FLUSH_INTERVAL=10
